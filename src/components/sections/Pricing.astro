---
/**
 * Pricing — three tiers from content.ts. The featured "Brand Growth" tier is
 * visually elevated (ring, scale, badge). Each CTA carries `data-plan` so the
 * LeadForm preselects the matching plan when clicked, and `?plan=` keeps it
 * working even on a hard navigation.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import Badge from '../ui/Badge.astro';
import { pricingTiers, CONTACT_ANCHOR } from '../../lib/content';
---

<section id="pricing" class="bg-bg-soft py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeading eyebrow="Pricing" title="Start sharp. Grow when ready." highlight="Grow when ready." align="center">
      <p class="max-w-2xl text-lg text-muted">
        A low-friction starter to get you online, then an upgrade path that turns
        your site into a steady stream of customers.
      </p>
    </SectionHeading>

    <div class="mt-14 grid items-stretch gap-6 lg:grid-cols-3">
      {pricingTiers.map((tier, i) => (
        <article
          data-reveal
          style={`--reveal-delay:${i * 100}ms`}
          class={`group relative flex flex-col rounded-3xl p-7 transition-all duration-300 hover:border-accent hover:shadow-[0_24px_50px_-24px_color-mix(in_srgb,var(--color-accent)_55%,transparent)] ${
            tier.featured
              ? 'bg-bg ring-2 ring-accent shadow-[0_24px_60px_-24px_color-mix(in_srgb,var(--color-accent)_55%,transparent)] lg:-translate-y-3 lg:scale-[1.03]'
              : 'border border-border bg-bg hover:border-ink/20'
          }`}
        >
          {tier.badge && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2">

              <Badge tone="accent">{tier.badge}</Badge>
            </div>
          )}

          <h3 class="font-display text-lg font-semibold">{tier.name}</h3>
          <p class="mt-1 text-sm text-muted">{tier.tagline}</p>

          <div class="mt-5 flex items-baseline gap-1">
            <span class="font-display text-4xl font-semibold text-ink">{tier.price}</span>
            {tier.cadence && <span class="text-muted">{tier.cadence}</span>}
          </div>

          <ul class="mt-6 flex flex-1 flex-col gap-3">
            {tier.features.map((feature) => (
              <li class="flex items-start gap-3 text-sm text-ink/90">
                <svg
                  class={`mt-0.5 h-4 w-4 shrink-0 ${tier.featured ? 'text-accent' : 'text-secondary'}`}
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <a
            href={CONTACT_ANCHOR}
            data-plan={tier.id}
            class={`mt-7 inline-flex items-center justify-center rounded-full px-6 py-3 font-medium transition-all duration-200 hover:-translate-y-0.5 ${
              tier.featured
                ? 'bg-accent text-white hover:bg-accent-deep'
                : 'border border-border text-ink hover:border-ink'
            }`}
          >
            {tier.cta.label}
          </a>

          {tier.footnote && (
            <p class="mt-4 border-t border-border pt-4 text-xs leading-relaxed text-muted">
              {tier.footnote}
            </p>
          )}
        </article>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-muted">
      Every plan is month-to-month. No long contracts, cancel anytime.
    </p>
  </div>
</section>
