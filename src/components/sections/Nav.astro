---
/**
 * Nav — sticky top navigation. Desktop links are static HTML; the mobile
 * hamburger + drawer is the only hydrated piece (MobileNav island).
 */
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import MobileNav from '../islands/MobileNav.tsx';
import { navLinks, CONTACT_ANCHOR } from '../../lib/content';
import MobileNavButton from '../islands/MobileNavButton';


---

<header class="sticky top-0 z-30 border-b border-border/70 bg-bg/80 backdrop-blur-md">
  <nav
    class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-5 sm:px-8"
    aria-label="Primary"
  >
    <Logo />

    <ul class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm text-ink/80 transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden md:block">
      <Button href={CONTACT_ANCHOR}>Get Started</Button>
    </div>

    <!-- Mobile only -->
    <MobileNavButton client:visible/>
  </nav>

</header>
<MobileNav client:idle />